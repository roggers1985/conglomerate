{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!plugins/factory/dist"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "noExcessiveCognitiveComplexity": "error",
                "useLiteralKeys": "off",
                "noUselessUndefined": "error",
                "noExcessiveLinesPerFunction": {
                    "level": "error",
                    "options": {
                        "maxLines": 70,
                        "skipBlankLines": true
                    }
                }
            },
            "correctness": {
                "noUnusedImports": "error",
                "noUnusedVariables": "error"
            },
            "style": {
                "useBlockStatements": "error",
                "noUselessElse": "error",
                "noNonNullAssertion": "error",
                "noParameterAssign": "error",
                "useConst": "error",
                "useImportType": "error",
                "useExportType": "error",
                "useNodejsImportProtocol": "error",
                "useTemplate": "error",
                "noNestedTernary": "error",
                "useFilenamingConvention": {
                    "level": "error",
                    "options": {
                        "filenameCases": ["kebab-case"]
                    }
                },
                "useNamingConvention": "error"
            },
            "suspicious": {
                "noExplicitAny": "error",
                "noEmptyBlockStatements": "error",
                "noSkippedTests": "error",
                "noFocusedTests": "error"
            },
            "nursery": {
                "noFloatingPromises": "error",
                "noMisusedPromises": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/*.test.ts"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveLinesPerFunction": "off"
                    }
                }
            }
        }
    ]
}
