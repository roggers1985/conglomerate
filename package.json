{
    "name": "conglomerate",
    "version": "0.1.0",
    "private": true,
    "description": "Marketplace repository for the factory plugin.",
    "license": "MIT",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "scripts": {
        "validate": "bun scripts/validate-plugin.ts",
        "generate": "bun scripts/generate.ts",
        "typecheck": "tsc",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "test": "bun test",
        "doctest": "bun plugins/factory/scripts/doctest.ts lib scripts plugins/factory/scripts",
        "check": "bun run typecheck && bun run lint && bun test && bun run doctest && bun run validate",
        "prepare": "git config core.hooksPath .githooks"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@standard-schema/spec": "^1.1.0",
        "@types/bun": "^1.4.4",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "zod": "^4.6.5"
    }
}
