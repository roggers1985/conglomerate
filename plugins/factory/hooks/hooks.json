{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bun \"${CLAUDE_PLUGIN_ROOT}/dist/session-start.js\""
                    },
                    {
                        "type": "command",
                        "command": "bun \"${CLAUDE_PLUGIN_ROOT}/dist/checkups.js\" reminder",
                        "timeout": 15
                    },
                    {
                        "type": "command",
                        "command": "bun \"${CLAUDE_PLUGIN_ROOT}/dist/toolbox.js\" reminder",
                        "timeout": 15
                    },
                    {
                        "type": "command",
                        "command": "bun \"${CLAUDE_PLUGIN_ROOT}/dist/changes.js\" reminder",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}
